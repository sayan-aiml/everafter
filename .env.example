# Supabase — public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — SERVER ONLY. Never import this in client components.
# Used only by: scheduled jobs, data export, data deletion routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Reserved for the future AI Companion (v2)
OPENAI_API_KEY=sk-...
